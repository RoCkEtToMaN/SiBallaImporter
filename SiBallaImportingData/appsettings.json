{
  // ======================================================================================================
  // RICETTE: per ogni caso il comando completo, da lanciare nella cartella del progetto (quella con il .sln).
  // In alternativa si possono mettere i valori qui sotto in "Import" (o "Email") e lanciare solo
  //   dotnet run --project SiBallaImportingData
  // Ciò che non è nel comando resta com'è in questo file (qui sotto è tutto false).
  // Scorciatoie dei comandi in Utils/AppSettings.cs. I valori effettivi sono stampati all'avvio ("Configurazione:").
  //
  // Prove dal PC: aggiungi --no-push a qualsiasi comando e il dizionario dei luoghi torna nel repo senza commit né push.
  // Anche senza, il push del dizionario parte solo da master e solo se non ci sono altri commit non pubblicati.
  //
  // 1) Giro completo, come su GitHub ogni giorno (cerca online -> Sheet -> email -> DB)
  //      dotnet run --project SiBallaImportingData -- --search --excel --send --db --indirizzi --immagini-sheet --Import:EmailSoloSeCambia=true --giorni=7
  //dotnet run -c Release --project SiBallaImportingData -- --search --excel --send --db --indirizzi --immagini-sheet --Import:EmailSoloSeCambia=true --giorni=7
  //
  // 2) Solo notifica email (bollettino dallo Sheet + eventi online non ancora nello Sheet), senza scrivere niente
  //      dotnet run --project SiBallaImportingData -- --search --send
  //    Senza --search l'email ha solo lo Sheet (niente "luogo da verificare" e niente eventi online).
  //    Parte anche se non è cambiato niente (EmailSoloSeCambia è false qui sotto).
  //
  // 3) Anteprima dell'email senza mandarla (il testo finisce in anteprima-email.html)
  //      dotnet run --project SiBallaImportingData -- --search --send --Email:PreviewFile=anteprima-email.html
  //
  // 4) Cerca online e aggiunge allo Sheet, senza email né DB
  //      dotnet run --project SiBallaImportingData -- --search --excel
  //
  // 5) Solo aggiornare il DB (Appwrite) dallo Sheet, senza cercare online
  //      dotnet run --project SiBallaImportingData -- --search=false --db
  //
  // 6) Sistemare lo Sheet: indirizzi con Gemini, immagini, coordinate in colonna F (poi la 5 per portarli sul DB)
  //      dotnet run --project SiBallaImportingData -- --search=false --indirizzi --immagini-sheet --coords
  //
  // 7) Prove che non scrivono niente (il programma si ferma dopo il test)
  //    classifica con Gemini gli eventi dei prossimi Giorni:
  //      dotnet run --project SiBallaImportingData -- --test-swing --no-push
  //    cerca con Gemini il locale delle righe senza indirizzo:
  //      dotnet run --project SiBallaImportingData -- --test-indirizzi --no-push
  //    conta le immagini trovate:
  //      dotnet run --project SiBallaImportingData -- --test-immagini --no-push
  //
  // 8) Pulizia lezioni dallo Sheet (il programma si ferma dopo)
  //    le elenca soltanto:
  //      dotnet run --project SiBallaImportingData -- --pulisci-lezioni --no-push
  //    le cancella dallo Sheet:
  //      dotnet run --project SiBallaImportingData -- --pulisci-lezioni-scrivi
  //
  // 9) Controllo con Gemini degli eventi PASSATI (righe "storico" recuperate dalle vecchie versioni dello Sheet)
  //    Serve la chiave Gemini. Il programma si ferma dopo. Le righe già controllate hanno la nota e vengono saltate:
  //    se si interrompe basta rilanciarlo. Da GitHub: Actions -> "Riclassifica storico" -> Run workflow.
  //    mostra soltanto l'esito (swing / non swing):
  //      dotnet run --project SiBallaImportingData -- --riclassifica-storico --no-push
  //    scrive: swing = nota "Gemini: swing" (+ stile se manca), non swing = "no" con il motivo nella nota:
  //      dotnet run --project SiBallaImportingData -- --riclassifica-storico-scrivi
  //
  // 10) Controllo con Gemini delle righe FUTURE "da verificare" mai classificate (senza colore né nota)
  //    mostra soltanto:
  //      dotnet run --project SiBallaImportingData -- --riclassifica-sheet --no-push
  //    scrive: swing = "nuovo", altri = riga arancione + motivo nella nota:
  //      dotnet run --project SiBallaImportingData -- --riclassifica-sheet-scrivi
  //
  // 11) Memoria delle serie sulle righe FUTURE (niente Gemini): serie che hai sempre scartato -> "no",
  //    "da verificare" di serie sempre confermate -> "nuovo", serie/organizzatori segnati da te "mercatino" o "workshop" -> idem;
  //    organizzatori con >= 2 date tutte "no" (nessuna confermata) -> "no". Poi copia in Workshop le righe "workshop" di Serate.
  //    Ogni giro con --excel lo fa già da solo.
  //    mostra soltanto:
  //      dotnet run --project SiBallaImportingData -- --memoria-serie --no-push
  //    scrive (valore + nota "Memoria: ..."):
  //      dotnet run --project SiBallaImportingData -- --memoria-serie-scrivi
  //
  // 12) Prova di Gemini sulle righe che hai già deciso tu (workshop, mercatini, no, serate confermate): Gemini le classifica
  //    senza memoria e il programma confronta le sue risposte con le tue. Serve la chiave Gemini; non scrive niente.
  //    In Visual Studio: profilo "Prova Gemini sullo Sheet". Righe per tipo: --Import:TestGeminiSheetMax=40
  //      dotnet run --project SiBallaImportingData -- --test-gemini-sheet --no-push
  //
  // ATTENZIONE, distruttive:
  //    svuota le collezioni Appwrite e le ricarica subito dallo Sheet (senza --db l'app resterebbe vuota):
  //      dotnet run --project SiBallaImportingData -- --search=false --reset-db --db
  //    svuota Serate e Workshop dalla riga 3, dopo averle copiate nello Sheet come "Backup ..." (+ JSON sul PC);
  //    ignorato su GitHub, il programma si ferma dopo:
  //      dotnet run --project SiBallaImportingData -- --reset-excel
  // ======================================================================================================
  "Import": {
    "EnableSearching": false,
    "EnableSending": false,
    // manda l'email solo se ci sono eventi che l'ultima non aveva
    "EmailSoloSeCambia": false,
    "EnableImportingOnExcel": false,
    "EnableImportingOnDB": false,
    "UpdateSheetCoordinates": false,
    "ResetDb": false,
    "ResetExcel": false,
    "PulisciLezioni": false,
    "PulisciLezioniScrivi": false,
    // ricetta 9: eventi passati ("storico") controllati da Gemini
    "RiclassificaStorico": false,
    "RiclassificaStoricoScrivi": false,
    // ricetta 10: righe future "da verificare" mai classificate
    "RiclassificaSheet": false,
    "RiclassificaSheetScrivi": false,
    // prove dal PC: il dizionario dei luoghi torna nel repo senza commit né push
    "NoPush": false,
    "TestImmagini": false,
    "TestSwing": false,
    "TestIndirizzi": false,
    "TestIndirizziMax": 10,
    "CercaIndirizzi": false,
    "CercaIndirizziMax": 20,
    "CercaImmaginiSheet": false,
    "CercaImmaginiSheetMax": 100,
    // finestra di date dell'email e della ricerca
    "Giorni": 90,
    // raggio della ricerca online in km (0 = nessun limite)
    "Radius": 0,
    // raggio del bollettino email in km
    "RadiusEmail": 300.0,
    "Centro": "Genova"
  },
  "Email": {
    // destinatari separati da ';'
    "Recipients": "Giacomo.lo87@gmail.com"
    // , "PreviewFile": "anteprima-email.html"   // se impostato l'email non parte: il testo finisce in questo file
  },
  "Gemini": {
    "Model": "gemini-flash-lite-latest",
    "UseGoogleSearch": false,
    "UseModelKnowledge": false
  },
  "Paths": {
    "DataDirectory": ""
  }
}
