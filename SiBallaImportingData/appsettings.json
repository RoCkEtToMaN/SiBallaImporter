{
  // ======================================================================================================
  // RICETTE: le combinazioni che si usano di solito. Copia i valori qui sotto in "Import" (o "Email"),
  // oppure passali da riga di comando: dotnet run -- --search --send ...  (scorciatoie in AppSettings.cs)
  // dotnet run --project SiBallaImportingData -- --search --excel --send --db --indirizzi --immagini-sheet --Import:EmailSoloSeCambia=true --giorni=7 (Esempio di comando completo)

  // Ciò che non è elencato in una ricetta resta false.
  // Prove dal PC: aggiungi --no-push e il dizionario dei luoghi torna nel repo senza commit né push.
  // Anche senza, il push del dizionario parte solo da master e solo se non ci sono altri commit non pubblicati.
  //
  // 1) Giro completo, come su GitHub ogni giorno (cerca online -> Sheet -> email -> DB)
  //      EnableSearching, EnableImportingOnExcel, EnableSending, EnableImportingOnDB,
  //      CercaIndirizzi, CercaImmaginiSheet = true;  EmailSoloSeCambia = true;  Giorni = 7
  //      riga di comando: --search --excel --send --db --indirizzi --immagini-sheet --Import:EmailSoloSeCambia=true --giorni=7
  //
  // 2) Solo notifica email (bollettino dallo Sheet + eventi online non ancora nello Sheet), senza scrivere niente
  //      EnableSearching, EnableSending = true      ->  --search --send
  //    Senza EnableSearching l'email ha solo lo Sheet (niente "luogo da verificare" e niente eventi online)
  //    Per mandarla anche se non è cambiato niente lascia EmailSoloSeCambia = false
  //
  // 3) Anteprima dell'email senza mandarla: come la 2, più "Email": { "PreviewFile": "anteprima-email.html" }
  //      --search --send --Email:PreviewFile=anteprima-email.html
  //
  // 4) Cerca online e aggiunge allo Sheet, senza email né DB
  //      EnableSearching, EnableImportingOnExcel = true      ->  --search --excel
  //
  // 5) Solo aggiornare il DB (Appwrite) dallo Sheet, senza cercare online
  //      EnableImportingOnDB = true;  EnableSearching = false      ->  --search=false --db
  //    (EnableSearching di default è true nel codice: va spento esplicitamente da riga di comando)
  //
  // 6) Sistemare lo Sheet: indirizzi con Gemini, immagini, coordinate in colonna F (poi --db per portarli sul DB)
  //      CercaIndirizzi, CercaImmaginiSheet, UpdateSheetCoordinates = true
  //      --search=false --indirizzi --immagini-sheet --coords
  //
  // 7) Prove che non scrivono niente (il programma si ferma dopo il test)
  //      TestSwing        classifica con Gemini gli eventi dei prossimi Giorni       --test-swing
  //      TestIndirizzi    cerca con Gemini il locale delle righe senza indirizzo      --test-indirizzi
  //      TestImmagini     conta le immagini trovate                                  --test-immagini
  //
  // 8) Pulizia lezioni dallo Sheet (il programma si ferma dopo)
  //      PulisciLezioni = true  -> le elenca soltanto                                 --pulisci-lezioni
  //      PulisciLezioniScrivi = true  -> le cancella dallo Sheet                      --pulisci-lezioni-scrivi
  //
  // ATTENZIONE, distruttive:
  //      ResetDb      svuota le collezioni Appwrite prima di ricaricarle             --reset-db
  //      ResetExcel   svuota lo Sheet dalla riga 3 (copia JSON prima; ignorato su GitHub)  --reset-excel
  // ======================================================================================================
  "Import": {
    "EnableSearching": false,
    "EnableSending": false,
    // manda l'email solo se ci sono eventi che l'ultima non aveva
    "EmailSoloSeCambia": false,
    "EnableImportingOnExcel": false,
    "EnableImportingOnDB": false,
    "UpdateSheetCoordinates": false,
    "ResetDb": false,
    "ResetExcel": false,
    "PulisciLezioni": false,
    "PulisciLezioniScrivi": false,
    "TestImmagini": false,
    "TestSwing": false,
    "TestIndirizzi": false,
    "TestIndirizziMax": 10,
    "CercaIndirizzi": false,
    "CercaIndirizziMax": 20,
    "CercaImmaginiSheet": false,
    "CercaImmaginiSheetMax": 100,
    // finestra di date dell'email e della ricerca
    "Giorni": 90,
    // raggio della ricerca online in km (0 = nessun limite)
    "Radius": 0,
    // raggio del bollettino email in km
    "RadiusEmail": 300.0,
    "Centro": "Genova"
  },
  "Email": {
    // destinatari separati da ';'
    "Recipients": "Giacomo.lo87@gmail.com"
    // , "PreviewFile": "anteprima-email.html"   // se impostato l'email non parte: il testo finisce in questo file
  },
  "Gemini": {
    "Model": "gemini-flash-lite-latest",
    "UseGoogleSearch": false,
    "UseModelKnowledge": false
  },
  "Paths": {
    "DataDirectory": ""
  }
}
