<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- le chiavi segrete stanno in secrets.config (non versionato): vedi secrets.config.example -->
	<appSettings file="secrets.config">
		<!-- Variabile per abilitare i log dettagliati -->
		<add key="EnableImportingOnDB" value="false"/>
		<add key="EnableImportingOnExcel" value="false"/>
		<!-- riscrive sullo sheet (colonna F) le coordinate trovate da Photon o verificate nel JSON -->
		<add key="UpdateSheetCoordinates" value="false"/>
		<!--<add key="ClearExcel" value="true" />-->
		<!-- Variabile per abilitare una funzionalità sperimentale -->
		<add key="EnableSearching" value="true" />
		<add key="EnableSending" value="false" />
		<add key="DatabaseUrl" value="https://siballa-8fc2f-default-rtdb.europe-west1.firebasedatabase.app/" />
		<add key="ResetDb" value="false" />
		<add key="TestImmagini" value="false" />
		<add key="GeminiModel" value="gemini-flash-latest" /> <!--modello per il controllo finale degli eventi; la chiave va nella variabile d'ambiente GEMINI_API_KEY-->
 <!--true: conta solo le immagini trovate, senza scrivere su foglio/DB-->

		<add key="Radius" value="300" /> <!--In Km-->
		<add key="Giorni" value="7" />
		<add key="Centro" value="Genova"/>
		<!--<add key="Email" ;La.palazzolo73@gmail.com ;teodrina@gmail.com;teodrina@gmail.com value="Giacomo.lo87@gmail.com;c.vota87@gmail.com;alessio.carrega@gmail.com;;piccolo.gv@gmail.com;pamelaraffo22@gmail.com"/>-->
		<add key="Email" value="Giacomo.lo87@gmail.com"/>
	</appSettings>
</configuration>