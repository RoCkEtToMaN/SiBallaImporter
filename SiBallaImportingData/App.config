<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Variabile per abilitare i log dettagliati -->
		<add key="EnableImporting" value="false" />

		<!-- Variabile per abilitare una funzionalità sperimentale -->
		<add key="EnableSearching" value="true" />
		<add key="Radius" value="10" /> <!--In Km-->
	</appSettings>
</configuration>