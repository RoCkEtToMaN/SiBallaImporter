<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
	<ApplicationIcon>Resources\iconLindyHopDipinto.ico</ApplicationIcon>
    <!-- chiavi segrete in locale: dotnet user-secrets set "Email:MailjetApiKey" "..." -->
    <UserSecretsId>siballa-importingdata</UserSecretsId>
<!-- 	<RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun> -->
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\siballa-8c6d48649c13.json" />
    <None Remove="Resources\siballa-a91afa101ace.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\siballa-8c6d48649c13.json" />
    <EmbeddedResource Include="Resources\siballa-a91afa101ace.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Appwrite" Version="8.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.70.0.3819" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Mailjet.Api" Version="3.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
    <PackageReference Include="NGeoNames" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Inclusione esplicita dei file di orchestrazione anche per il progetto caricato nell'IDE. -->
  <ItemGroup>
    <Compile Remove="Application\ImportRunner.cs;Application\ImportCommands.cs" />
    <Compile Include="Application\ImportRunner.cs" />
    <Compile Include="Application\ImportCommands.cs" />
  </ItemGroup>
</Project>
